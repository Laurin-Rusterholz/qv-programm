# Virtuelle Umgebung und Python-Cache
.venv/
__pycache__/
*.pyc

# Node / Browser-App (nur fuer Tests; die App selbst braucht kein node_modules)
web/node_modules/
web/test-results/

# Geheime Werte - niemals hochladen
.env
.streamlit/secrets.toml

# Inhalte der Arbeitsordner nicht ins Git aufnehmen,
# die Ordner selbst aber behalten.
uploads/*
outputs/*
theorie/*
!uploads/.gitkeep
!outputs/.gitkeep
!theorie/.gitkeep
!theorie/LIESMICH.txt
