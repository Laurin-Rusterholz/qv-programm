# Vorlage fuer Secrets (Passwort und optional API-Schluessel).
#
# ONLINE (Streamlit Community Cloud):
#   App-Seite -> "Settings" -> "Secrets" -> diesen Inhalt einfuegen und ausfuellen.
#
# LOKAL (optional):
#   Diese Datei kopieren zu  .streamlit/secrets.toml  und ausfuellen.
#   Sie wird NICHT ins Git aufgenommen.

# Passwortschutz fuer den Online-Betrieb. Ist dieser Wert gesetzt, fragt die App
# beim Start nach dem Passwort. Leer lassen oder weglassen = kein Passwort.
APP_PASSWORT = "hier-ein-eigenes-passwort"

# Optional: API-Schluessel dauerhaft hinterlegen, damit du ihn nicht jedes Mal
# eintippen musst. Sonst einfach im Feld in der App eingeben.
ANTHROPIC_API_KEY = "sk-ant-dein-schluessel"
